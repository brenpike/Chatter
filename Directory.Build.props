<Project>

  <!-- Coverage-only properties, scoped to test projects (names ending in '.Tests').
       This naturally excludes Chatter.Testing.Core (ends in '.Core') and library
       projects, so nothing here alters packaged library output. CollectCoverage is
       intentionally NOT set: CI passes /p:CollectCoverage=true; default OFF keeps plain
       `dotnet test` fast. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <!-- coverlet 10.0.1 with an explicit (non-trailing-slash) filename inserts
         '.$(TargetFramework)' before the final '.' segment ONLY when the project
         multi-targets. Now that every project single-targets net10.0, supplying
         '<ProjectName>.cobertura.xml' yields exactly that name, with no TFM segment:
         artifacts/coverage/<ProjectName>.cobertura.xml (empirically verified). Do NOT
         add $(TargetFramework) here — the per-project name is already unique, and CI's
         aggregate-coverage glob in .github/workflows/ci.yml matches this exact shape. -->
    <CoverletOutput>$(MSBuildThisFileDirectory)artifacts/coverage/$(MSBuildProjectName).cobertura.xml</CoverletOutput>
    <ExcludeByAttribute>GeneratedCodeAttribute;CompilerGeneratedAttribute;ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
    <Exclude>[*.Tests]*;[Chatter.Testing.Core]*</Exclude>
  </PropertyGroup>

  <!-- Package provenance, scoped to the nine packable library projects. Keying on
       '$(IsPackable)' is impossible here: Directory.Build.props is imported before the project
       body, so a csproj's IsPackable is still unset at this point. Every packable project lives
       at src/<Module>/src/<Module>/, so its parent directory is named 'src'. Per-module test
       projects (src/<Module>/tests/) and the shared test core (tests/) do not match, so nothing
       below reaches non-packaged output.
       ContinuousIntegrationBuild is deliberately NOT set here: it normalizes source paths and
       breaks local debugging. The CD pack steps pass it on the command line instead. -->
  <PropertyGroup>
    <IsPackableLibrary Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' == 'src'">true</IsPackableLibrary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackableLibrary)' == 'true'">
    <!-- SourceLink ships in the SDK and is on by default; these let it publish the repository
         url and embed sources that are not tracked by git.
         https://learn.microsoft.com/en-us/dotnet/standard/library-guidance/sourcelink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/brenpike/Chatter</PackageProjectUrl>
  </PropertyGroup>

  <!-- Each packable module owns a README at src/<Module>/src/README.md, one directory above its
       project directory. PackageReadmeFile above only names the file inside the package; this
       item is what places that module's own readme at the package root. -->
  <ItemGroup Condition="'$(IsPackableLibrary)' == 'true'">
    <None Include="$(MSBuildProjectDirectory)/../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
