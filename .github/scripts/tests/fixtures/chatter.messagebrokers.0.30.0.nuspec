<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Chatter.MessageBrokers</id>
    <version>0.30.0</version>
    <authors>Brennan Pike</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/brenpike/Chatter</projectUrl>
    <description>A message broker adapter library built on top of Chatter.CQRS.</description>
    <tags>Messaging,.NET,</tags>
    <repository type="git" url="https://github.com/brenpike/Chatter" branch="refs/heads/master" commit="11f362edd270001d3e2fdd5d35d55ff77ad07201" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Chatter.CQRS" version="0.16.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Hosting" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="Scrutor" version="3.3.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Chatter.CQRS" version="0.16.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Hosting" version="8.0.1" exclude="Build,Analyzers" />
        <dependency id="Scrutor" version="3.3.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>